{
  "manifest_version": 3,
  "name": "Tolerance: Doomscroll, Clickbait & AI Slop Blocker",
  "short_name": "Tolerance",
  "version": "0.1.36",
  "description": "A digital detox without blocking: blurs clickbait, rage bait, AI slop and ads on Facebook, YouTube, Instagram, X & Reddit.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://claude.ai/*",
    "*://www.tiktok.com/*",
    "*://api.openai.com/*",
    "*://api.anthropic.com/*",
    "*://api.groq.com/*",
    "*://api.together.xyz/*",
    "*://api.mistral.ai/*",
    "*://api.fireworks.ai/*",
    "*://api.perplexity.ai/*",
    "*://api.cohere.ai/*",
    "*://generativelanguage.googleapis.com/*",
    "*://api-inference.huggingface.co/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "host_permissions": [
    "*://old.reddit.com/*",
    "*://www.reddit.com/*",
    "*://reddit.com/*",
    "*://twitter.com/*",
    "*://x.com/*",
    "*://www.youtube.com/*",
    "*://www.instagram.com/*",
    "*://www.facebook.com/*",
    "*://openrouter.ai/*",
    "*://*.tolerance.lol/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://old.reddit.com/*",
        "*://www.reddit.com/*",
        "*://reddit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://old.reddit.com/*",
        "*://www.reddit.com/*",
        "*://reddit.com/*"
      ],
      "css": [
        "reddit-gate.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*"
      ],
      "js": [
        "twitter-early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*"
      ],
      "js": [
        "twitter.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.facebook.com/*"
      ],
      "js": [
        "facebook-early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.facebook.com/*"
      ],
      "js": [
        "facebook.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "js": [
        "instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "exclude_matches": [
        "*://www.instagram.com/explore*",
        "*://www.instagram.com/reels*",
        "*://www.instagram.com/reel/*",
        "*://www.instagram.com/stories*",
        "*://www.instagram.com/direct*",
        "*://www.instagram.com/accounts*",
        "*://www.instagram.com/p/*"
      ],
      "css": [
        "instagram-gate.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "youtube-early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tolerance",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
